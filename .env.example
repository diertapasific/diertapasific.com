# Server-only. In Vercel use the Secret type for these values.
GROQ_API_KEY=
SPOTIFY_REFRESH_TOKEN=
UPSTASH_REDIS_REST_TOKEN=

# Config values. Never prefix credentials with VITE_.
GROQ_MODEL=openai/gpt-oss-20b
SPOTIFY_CLIENT_ID=422e9c35a9d64240bbb57440d968061b
UPSTASH_REDIS_REST_URL=

# Vercel's Upstash integration may instead provide KV_REST_API_URL and
# KV_REST_API_TOKEN; both pairs are supported. Use Production secrets only
# until a separate preview connection is configured.

# Public canonical address; set this to the production domain before redeploying.
SITE_URL=https://diertapasific.vercel.app

# Optional local-only proxy after production is connected. Leave empty to
# authorize and poll a separate local Spotify connection.
SPOTIFY_PUBLIC_STATUS_URL=
